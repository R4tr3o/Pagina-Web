extends layout

block content
  h1 Chat: #{nombre_grupo}

  .chat-box(style="border: 1px solid #ccc; padding: 15px; height: 300px; overflow-y: scroll; background: #f9f9f9;")
    each msg in mensajes
      p
        strong= msg.usuario + ': '
        span= msg.texto
        small(style="color: gray; margin-left: 10px;") #{msg.fecha_hora}
    else
      p No hay mensajes todavía en este grupo. ¡Sé el primero en escribir!

  hr
  h3 Enviar Mensaje
  form(action="/mensajes/enviar" method="POST")
    input(type="hidden" name="id_grupo" value=id_grupo)
    textarea(name="texto" required placeholder="Escribe tu mensaje aquí..." rows="3" cols="40")
    br
    button(type="submit") Enviar Mensaje
