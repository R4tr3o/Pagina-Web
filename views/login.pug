```html
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Iniciar sesión - Madrid Scooter</title>
    <link rel="stylesheet" href="login.css">
</head>
<body>

    <div class="contenedor">

        <div class="login">

            <div class="logo">
                <h1>Madrid Scooter</h1>
                <p>Muévete por Madrid de forma sostenible</p>
            </div>

            <h2>Bienvenido de nuevo</h2>
            <p class="subtitulo">Inicia sesión para continuar</p>

            <form action="#" method="POST">

                <div class="campo">
                    <label for="email">Correo electrónico</label>
                    <input type="email" id="email" name="email"
                           placeholder="Introduce tu correo" required>
                </div>

                <div class="campo">
                    <label for="password">Contraseña</label>
                    <input type="password" id="password" name="password"
                           placeholder="Introduce tu contraseña" required>
                </div>

                <div class="opciones">
                    <label>
                        <input type="checkbox" name="recordar">
                        Recordarme
                    </label>

                    <a href="#">¿Has olvidado tu contraseña?</a>
                </div>

                <button type="submit">Iniciar sesión</button>

            </form>

            <div class="registro">
                <p>¿Todavía no tienes una cuenta?
                    <a href="#">Regístrate</a>
                </p>
            </div>

        </div>

    </div>

</body>
</html>
```