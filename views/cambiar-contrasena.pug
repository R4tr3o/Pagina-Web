extends layout

block content
  h1 Cambiar contraseña
  if error
    p(role='alert')= error
  if notice
    p(role='status')= notice
  form(method='POST', action='/cambiar-contrasena')
    div
      label(for='passwordActual') Contraseña actual:
      input#passwordActual(type='password', name='passwordActual', required, autocomplete='current-password')
    br
    div
      label(for='passwordNueva') Nueva contraseña:
      input#passwordNueva(type='password', name='passwordNueva', required, minlength='8', autocomplete='new-password')
    br
    div
      label(for='confirmarPassword') Confirmar nueva contraseña:
      input#confirmarPassword(type='password', name='confirmarPassword', required, minlength='8', autocomplete='new-password')
    br
    button(type='submit') Guardar contraseña
