extends layout

block content
  .d-flex.flex-column.flex-md-row.justify-content-between.align-items-md-end.gap-3.mb-4
    div
      p.page-kicker Gestión del equipo
      h1.page-title Panel de administración
      p.page-subtitle Administra usuarios, permisos y grupos desde un mismo lugar.
    span.badge.rounded-pill.text-bg-light.border.px-3.py-2 Sesión de administrador

  if notice
    .alert.alert-success(role='status')= notice
  if error
    .alert.alert-danger(role='alert')= error

  .row.g-3.mb-4
    .col-sm-6.col-lg-4
      .metric-card
        span.metric-label Usuarios registrados
        strong.metric-value= usuarios.length
    .col-sm-6.col-lg-4
      .metric-card
        span.metric-label Grupos disponibles
        strong.metric-value= grupos.length

  section.content-card.mb-4
    .mb-4
      h2.section-title Dar de alta un usuario
      p.section-description Crea una cuenta y asígnale permisos y grupo.
    form(method='POST', action='/panel/alta-usuario')
      .row.g-3
        .col-md-6
          label.form-label(for='usuario') Usuario
          input#usuario.form-control(type='text', name='usuario', maxlength='40', required, placeholder='Ej. maria.garcia')
        .col-md-6
          label.form-label(for='nombre') Nombre completo
          input#nombre.form-control(type='text', name='nombre', maxlength='100', required, placeholder='Nombre y apellidos')
        .col-md-6
          label.form-label(for='password') Contraseña
          input#password.form-control(type='password', name='password', minlength='8', required, autocomplete='new-password')
          .form-text Mínimo 8 caracteres.
        .col-md-3
          label.form-label(for='rol-nuevo') Rol
          select#rol-nuevo.form-select(name='rol')
            option(value='usuario') Usuario normal
            option(value='admin') Administrador
        .col-md-3
          label.form-label(for='grupo-nuevo') Grupo
          select#grupo-nuevo.form-select(name='id_grupo')
            option(value='') Sin grupo
            each grupo in grupos
              option(value=grupo.id_grupo)= grupo.nombre
        .col-12
          button.btn.btn-primary(type='submit') Crear usuario

  section.content-card.mb-4
    .d-flex.flex-column.flex-sm-row.justify-content-between.align-items-sm-end.gap-3.mb-4
      div
        h2.section-title Grupos
        p.section-description.mb-0 Crea grupos y controla quién pertenece a cada uno.
      form.d-flex.flex-column.flex-sm-row.gap-2(method='POST', action='/panel/alta-grupo')
        label.visually-hidden(for='nombre-grupo') Nombre del grupo
        input#nombre-grupo.form-control(type='text', name='nombre', maxlength='50', required, placeholder='Nombre del grupo')
        button.btn.btn-outline-primary.text-nowrap(type='submit') Crear grupo

    .table-responsive
      table.table.table-hover.align-middle
        thead
          tr
            th(scope='col') Grupo
            th(scope='col') Usuarios asignados
            th(scope='col') Acciones
        tbody
          if grupos.length
            each grupo in grupos
              tr
                td.fw-semibold= grupo.nombre
                td
                  span.badge.rounded-pill.bg-light.text-dark= grupo.miembros
                  if grupo.miembros
                    span.ms-2.small.text-muted usuarios
                td
                  if grupo.miembros
                    button.btn.btn-sm.btn-outline-secondary(type='button', disabled, title='El grupo tiene usuarios asignados') En uso
                  else
                    form.confirm-delete-form(method='POST', action='/panel/baja-grupo/' + grupo.id_grupo, data-confirm-message='¿Seguro que quieres borrar este grupo? También se borrarán sus mensajes.')
                      button.btn.btn-sm.btn-outline-danger(type='submit') Borrar grupo
          else
            tr
              td.text-center.text-muted.py-4(colspan='3') Todavía no hay grupos. Crea el primero con el formulario superior.

  section.content-card
    .mb-4
      h2.section-title Usuarios registrados
      p.section-description.mb-0 Ajusta el rol, el grupo y la foto de cada cuenta. Formatos JPG, PNG o WebP; máximo 2 MB.
    .table-responsive
      table.table.table-hover.align-middle
        thead
          tr
            th(scope='col') Usuario
            th(scope='col') Nombre
            th(scope='col') Rol actual
            th(scope='col') Grupo actual
            th(scope='col') Acciones
        tbody
          if usuarios.length
            each usuario in usuarios
              tr
                td
                  .d-flex.align-items-center.gap-2
                    span.profile-avatar
                      if usuario.fotoUrl
                        img.profile-photo(src=usuario.fotoUrl, alt='', onerror='this.nextElementSibling.hidden = false; this.remove()')
                        span.profile-initial(aria-hidden='true', hidden)= usuario.nombre.charAt(0).toUpperCase()
                      else
                        span.profile-initial(aria-hidden='true')= usuario.nombre.charAt(0).toUpperCase()
                    span.user-cell= usuario.usuario
                td= usuario.nombre
                td
                  span.badge.rounded-pill(class=usuario.admin ? 'text-bg-primary' : 'bg-light text-dark')= usuario.admin ? 'Administrador' : 'Usuario'
                td= usuario.nombre_grupo || 'Sin grupo'
                td
                  form(method='POST', action='/panel/modificar-usuario/' + encodeURIComponent(usuario.usuario))
                    .d-flex.flex-column.flex-xl-row.gap-2
                      select.form-select.form-select-sm(name='rol', aria-label='Rol de ' + usuario.usuario)
                        if usuario.usuario === usuarioSesion
                          option(value='admin', selected) Administrador
                        else
                          option(value='usuario', selected=!usuario.admin) Usuario normal
                          option(value='admin', selected=!!usuario.admin) Administrador
                      select.form-select.form-select-sm(name='id_grupo', aria-label='Grupo de ' + usuario.usuario)
                        option(value='', selected=!usuario.id_grupo) Sin grupo
                        each grupo in grupos
                          option(value=grupo.id_grupo, selected=usuario.id_grupo === grupo.id_grupo)= grupo.nombre
                      button.btn.btn-sm.btn-outline-primary.text-nowrap(type='submit') Guardar
                  form.photo-upload-form(method='POST', enctype='multipart/form-data', action='/panel/foto/' + encodeURIComponent(usuario.usuario))
                    .input-group.input-group-sm.mt-2
                      input.form-control(type='file', name='foto', accept='image/jpeg,image/png,image/webp', aria-label='Foto para ' + usuario.nombre, required)
                      button.btn.btn-outline-secondary(type='submit') Subir foto
                  form.confirm-delete-form(method='POST', action='/panel/baja-usuario/' + encodeURIComponent(usuario.usuario), data-confirm-message='¿Seguro que quieres borrar a este usuario? Esta acción no se puede deshacer.')
                    button.btn.btn-sm.btn-outline-danger.mt-2(type='submit') Borrar
          else
            tr
              td.text-center.text-muted.py-4(colspan='5') Todavía no hay usuarios registrados.

  dialog#confirm-delete-dialog.confirm-dialog(aria-labelledby='confirm-delete-title')
    span.confirm-icon(aria-hidden='true') !
    h2#confirm-delete-title.fs-5.fw-bold Confirmar eliminación
    p#confirm-delete-message.text-muted.mb-0
    .d-flex.justify-content-end.gap-2.mt-4
      button#cancel-delete.btn.btn-light(type='button') Cancelar
      button#confirm-delete.btn.btn-danger(type='button') Borrar

  script.
    (function () {
      const dialog = document.getElementById('confirm-delete-dialog');
      let pendingForm = null;

      document.querySelectorAll('.confirm-delete-form').forEach((form) => {
        form.addEventListener('submit', (event) => {
          event.preventDefault();
          pendingForm = form;
          document.getElementById('confirm-delete-message').textContent =
            form.dataset.confirmMessage;
          dialog.showModal();
        });
      });

      document.getElementById('cancel-delete').addEventListener('click', () => {
        pendingForm = null;
        dialog.close();
      });

      document.getElementById('confirm-delete').addEventListener('click', () => {
        if (pendingForm) {
          HTMLFormElement.prototype.submit.call(pendingForm);
        }
      });
    }());
